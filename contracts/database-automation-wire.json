{
  "schemaVersion": 3,
  "name": "database-automation",
  "bounds": {
    "listPage": 32,
    "evaluationChunk": 32,
    "identifierRunes": 160,
    "nameRunes": 200,
    "documentBytes": 65536,
    "resultBytes": 262144,
    "dailyIntervalDays": 365,
    "weeklyIntervalWeeks": 52,
    "monthlyIntervalMonths": 24,
    "yearlyIntervalYears": 10,
    "scheduleAdmissionChunk": 32,
    "scheduleMaxRuns": 999,
    "deliveryClaimChunk": 8,
    "deliveryLeaseMilliseconds": 30000,
    "deliveryMaxAttempts": 5,
    "deliveryRetryBaseMilliseconds": 30000,
    "deliveryRetryMaxMilliseconds": 1800000,
    "deliveryPayloadBytes": 65536,
    "deliveryResponseBytes": 65536
  },
  "errors": {
    "invalid": "LEAFEN_DATABASE_AUTOMATION_INVALID",
    "notFound": "LEAFEN_DATABASE_AUTOMATION_NOT_FOUND",
    "unsupported": "LEAFEN_DATABASE_AUTOMATION_UNSUPPORTED",
    "conflict": "LEAFEN_DATABASE_AUTOMATION_CONFLICT",
    "mutationIdReused": "LEAFEN_DATABASE_AUTOMATION_MUTATION_ID_REUSED",
    "storageUnavailable": "LEAFEN_DATABASE_AUTOMATION_STORAGE_UNAVAILABLE",
    "databaseBusy": "LEAFEN_DATABASE_AUTOMATION_DATABASE_BUSY",
    "unavailable": "LEAFEN_DATABASE_AUTOMATION_UNAVAILABLE"
  },
  "scopeTypes": ["database", "view"],
  "triggerTypes": ["events", "schedule"],
  "triggerConditionTypes": ["row_added", "property_edited"],
  "triggerConditionOperators": ["is", "is_not", "contains", "does_not_contain", "starts_with", "ends_with", "greater_than", "less_than", "greater_or_equal", "less_or_equal", "cleared"],
  "triggerModes": ["any", "all"],
  "scheduleFrequencies": ["daily", "weekly", "monthly", "yearly"],
  "statuses": ["active", "disabled", "paused", "deleted"],
  "outcomeStatuses": ["completed", "stale", "paused"],
  "pausedReasons": ["action", "view", "schedule", "permission", "dlp", "delivery", "webhooks_off"],
  "deliveryChannels": ["notification", "email", "webhook", "slack"],
  "deliveryStatuses": ["pending", "claimed", "retrying", "succeeded", "failed", "stale"],
  "operations": [
    { "goName": "list", "method": "GET", "path": "/pages/{pageId}/databases/{databaseId}/automations" },
    { "goName": "create", "method": "POST", "path": "/pages/{pageId}/databases/{databaseId}/automations" },
    { "goName": "update", "method": "PATCH", "path": "/pages/{pageId}/databases/{databaseId}/automations/{automationId}" },
    { "goName": "delete", "method": "DELETE", "path": "/pages/{pageId}/databases/{databaseId}/automations/{automationId}" },
    { "goName": "enabled", "method": "POST", "path": "/pages/{pageId}/databases/{databaseId}/automations/{automationId}/enabled" },
    { "goName": "resume", "method": "POST", "path": "/pages/{pageId}/databases/{databaseId}/automations/{automationId}/resume" }
  ]
}
