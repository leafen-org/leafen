{
  "schemaVersion": 1,
  "name": "file-security-policy",
  "defaultContentType": "application/octet-stream",
  "maxContentTypeLength": 128,
  "errors": {
    "invalidContentType": "LEAFEN_FILE_CONTENT_TYPE_INVALID",
    "unsafeType": "LEAFEN_FILE_UNSAFE_TYPE"
  },
  "activeContentTypes": [
    "application/ecmascript",
    "application/javascript",
    "application/xhtml+xml",
    "application/xml",
    "image/svg+xml",
    "text/css",
    "text/ecmascript",
    "text/html",
    "text/javascript",
    "text/xml"
  ],
  "activeExtensions": [
    "cjs",
    "css",
    "hta",
    "htm",
    "html",
    "js",
    "mht",
    "mhtml",
    "mjs",
    "shtml",
    "svg",
    "svgz",
    "xht",
    "xhtml",
    "xml",
    "xsl",
    "xslt"
  ],
  "sandboxedHtml": {
    "contentType": "text/html",
    "extensions": [
      "htm",
      "html"
    ]
  }
}
