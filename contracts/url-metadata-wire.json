    { "goName": "errorCodeURLMetadataNotPdf", "tsName": "notPdf", "value": "URL_METADATA_NOT_PDF" },
    { "goName": "errorCodeURLMetadataParserLimit", "tsName": "parserLimit", "value": "URL_METADATA_PARSER_LIMIT" },
