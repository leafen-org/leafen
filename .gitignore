.DS_Store
.env
.env.*
# The server's own data folder when run from here; apps' data/ folders are theirs.
/data/
/data-dev/
dist/
# The app SDK keeps its generated build (scripts/generate-app-sdk.mjs).
!sdk/app/dist/
/coverage/
web/dist/
web/node_modules/
**/node_modules/
*.log
# Programs built in the source root by a plain go build, for any system.
/leafen
/leafen-runner
/leafen.exe
/leafen-runner.exe
# The benchmark tool's runs (bench/).
bench-run/
# The build stamp scripts/stamp-build.mjs writes before a build (internal/app/server_build.go).
internal/app/build_stamp/stamp.json
internal/app/build_stamp/changes.txt.gz
