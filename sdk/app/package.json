{
  "name": "@leafen/app-sdk",
  "version": "0.1.0",
  "description": "Write apps for Leafen: the screen's channel to Leafen, the manifest's schema and types.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./manifest": { "types": "./dist/manifest.d.ts", "default": "./dist/manifest.js" },
    "./schema": "./schema/leafen-app.schema.json"
  },
  "files": ["dist", "schema", "LICENSE", "README.md"]
}
