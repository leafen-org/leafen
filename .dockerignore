# The build context. The web stage copies all of it (the web build's checks
# read across the tree), so this lists only what no build reads: the
# repository's history, secrets, data and what builds leave behind, as
# .gitignore does.
.git
**/.DS_Store
**/.env
**/.env.*
.experiments
data
data-dev
coverage
tests
dist
web/dist
web/tsconfig.tsbuildinfo
**/node_modules
**/*.log
# Programs a plain go build leaves in the source root.
leafen
leafen-runner
leafen.exe
leafen-runner.exe
# The benchmark tool's runs (bench/).
bench-run
# The desktop app's own builds and its phone projects.
desktop/.task
desktop/bin
desktop/build/android
desktop/build/ios
# The app SDK's Rust build.
sdk/app/rust/leafen/target
