<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon as Android 8 and later draw it: the full-bleed picture in the
     inner 72dp of the 108dp layer, cut by the launcher's own shape (circle,
     squircle, rounded square), as iOS and macOS cut the same picture. Older
     Android, which cuts no shape, takes the rounded-corner ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
