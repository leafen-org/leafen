<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The macOS app's entitlements under the hardened runtime
         (scripts/package-desktop.mjs). The app platform's WebAssembly runtime
         (wazero) compiles each app to machine code in memory it maps itself,
         without MAP_JIT, which the hardened runtime refuses to make
         executable without this. The store edition, which has no app
         platform, is signed without it. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
