<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The development bundle's (ios:run, Info.dev.plist) simulator
         entitlements, as entitlements.simulator.plist is the release
         bundle's: the application identifier names this bundle, or the
         simulator refuses the app what the Files picker hands it (a picked
         folder for backups came back "Could not resolve bookmark"). -->
    <key>application-identifier</key>
    <string>FAKETEAMID.org.leafen.app.dev</string>
    <key>keychain-access-groups</key>
    <array>
        <string>FAKETEAMID.org.leafen.app.dev</string>
    </array>
</dict>
</plist>
