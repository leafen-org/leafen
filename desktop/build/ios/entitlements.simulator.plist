<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Simulator builds only, linked into the executable: the simulator's
         keychain needs an application identifier and access group, which
         a device build gets from its provisioning profile instead. -->
    <key>application-identifier</key>
    <string>FAKETEAMID.org.leafen.app</string>
    <key>keychain-access-groups</key>
    <array>
        <string>FAKETEAMID.org.leafen.app</string>
    </array>
</dict>
</plist>
