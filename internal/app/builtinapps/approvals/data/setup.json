{
  "language": "ko",
  "names": {
    "en": {
      "결재 요청": "Approval requests",
      "제목": "Title",
      "상태": "Status",
      "초안": "Draft",
      "대기": "Waiting",
      "승인": "Approved",
      "반려": "Rejected",
      "요청자": "Requester",
      "결재자": "Approver",
      "금액": "Amount",
      "사유": "Reason",
      "관련 페이지": "Related page",
      "결정 메모": "Decision note",
      "결정일": "Decided"
    }
  },
  "steps": [
    {
      "key": "requests",
      "tool": "create-database",
      "args": {
        "parent": { "page_id": "{{root}}" },
        "title": "결재 요청",
        "schema": "CREATE TABLE (\"제목\" TITLE, \"상태\" SELECT('초안':gray, '대기':yellow, '승인':green, '반려':red), \"요청자\" PEOPLE, \"결재자\" PEOPLE, \"금액\" NUMBER FORMAT 'number_with_commas', \"사유\" RICH_TEXT, \"관련 페이지\" URL, \"결정 메모\" RICH_TEXT, \"결정일\" DATE)"
      }
    }
  ]
}
