{
  "schema": 1,
  "id": "app.leafen.approvals",
  "slug": "approvals",
  "version": "1.0.26",
  "name": { "en": "Approvals", "ko": "결재" },
  "description": {
    "en": "Ask for approval, decide what waits for you and see where every request stands.",
    "ko": "결재를 올리고, 내게 온 결재를 처리하고, 요청이 어디까지 왔는지 봅니다."
  },
  "developer": { "name": "Leafen" },
  "icon": "ui/icon.svg",
  "category": "work",
  "tags": ["approvals", "dashboard"],
  "surfaces": {
    "fullPage": { "entry": "ui/index.html" },
    "blocks": [
      { "key": "summary", "name": { "en": "Approvals at a glance", "ko": "결재 현황" }, "entry": "ui/block.html", "defaultHeight": 132 }
    ]
  },
  "personAccess": "read",
  "data": [ { "key": "requests", "file": "data/setup.json", "locked": true } ],
  "network": {},
  "workers": [
    { "name": "rules", "module": "workers/main.wasm", "functions": ["submit", "draft", "decide", "pending", "overview", "remind"] }
  ],
  "schedules": [
    { "key": "morning", "name": { "en": "Weekday reminder of waiting approvals", "ko": "평일 아침 결재 대기 알림" }, "cron": "0 9 * * 1-5", "worker": "rules", "function": "remind", "perPerson": true }
  ],
  "actions": [
    {
      "key": "submit",
      "name": { "en": "Ask for approval", "ko": "결재 올리기" },
      "description": { "en": "Sends a request to the person who approves it.", "ko": "결재자에게 결재 요청을 보냅니다." },
      "inputLabels": { "requestId": { "en": "Request", "ko": "결재 요청" }, "title": { "en": "Title", "ko": "제목" }, "approver": { "en": "Approver", "ko": "결재자" }, "amount": { "en": "Amount", "ko": "금액" }, "reason": { "en": "Reason", "ko": "사유" }, "pageId": { "en": "Page", "ko": "페이지" } },
      "input": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "maxLength": 64 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "approver": { "type": "string", "minLength": 1, "maxLength": 64 },
          "amount": { "type": "number", "minimum": 0 },
          "reason": { "type": "string", "maxLength": 2000 },
          "pageId": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "required": ["title", "approver"],
        "additionalProperties": false
      },
      "runAs": "app", "worker": "rules", "function": "submit", "risk": "medium", "requiresApproval": true, "tool": true
    },
    {
      "key": "draft",
      "name": { "en": "Start a request from here", "ko": "여기서 결재 초안 만들기" },
      "input": {
        "type": "object",
        "properties": { "place": { "type": "string" }, "pageId": { "type": "string", "minLength": 1, "maxLength": 255 } },
        "required": ["pageId"]
      },
      "runAs": "app", "worker": "rules", "function": "draft", "risk": "low"
    },
    {
      "key": "approve",
      "name": { "en": "Approve", "ko": "승인" },
      "inputLabels": { "requestId": { "en": "Request", "ko": "결재 요청" }, "note": { "en": "Note", "ko": "의견" } },
      "input": {
        "type": "object",
        "properties": { "requestId": { "type": "string", "minLength": 1, "maxLength": 64 }, "note": { "type": "string", "maxLength": 2000 } },
        "required": ["requestId"], "additionalProperties": false
      },
      "runAs": "app", "worker": "rules", "function": "decide", "risk": "medium", "requiresApproval": true, "tool": true
    },
    {
      "key": "reject",
      "name": { "en": "Reject", "ko": "반려" },
      "inputLabels": { "requestId": { "en": "Request", "ko": "결재 요청" }, "note": { "en": "Note", "ko": "의견" } },
      "input": {
        "type": "object",
        "properties": { "requestId": { "type": "string", "minLength": 1, "maxLength": 64 }, "note": { "type": "string", "maxLength": 2000 } },
        "required": ["requestId"], "additionalProperties": false
      },
      "runAs": "app", "worker": "rules", "function": "decide", "risk": "medium", "requiresApproval": true, "tool": true
    },
    {
      "key": "pending",
      "name": { "en": "What waits for me", "ko": "내 결재 대기" },
      "description": { "en": "Requests waiting for the person to decide.", "ko": "내가 결정할 결재 요청입니다." },
      "input": { "type": "object", "additionalProperties": false },
      "runAs": "app", "worker": "rules", "function": "pending", "risk": "low", "tool": true
    },
    {
      "key": "overview",
      "name": { "en": "Overview", "ko": "현황" },
      "input": { "type": "object", "additionalProperties": false },
      "runAs": "app", "worker": "rules", "function": "overview", "risk": "low"
    }
  ],
  "notifications": true,
  "agent": {
    "summary": { "en": "Approval requests: ask, decide and list what waits.", "ko": "결재 요청: 올리기, 결정하기, 대기 목록." },
    "instructions": {
      "en": "Use pending to list what waits for the person. submit and approve or reject ask the person first; give a short title and the approver's user id.",
      "ko": "pending으로 내 결재 대기를 봅니다. submit·approve·reject는 사람에게 먼저 묻습니다. 제목은 짧게, 결재자는 사용자 ID로 줍니다."
    },
    "resources": [ { "key": "waiting", "name": "내 결재 대기 목록", "action": "pending" } ],
    "prompts": [
      { "key": "draft", "name": "결재 요청서 작성", "template": "다음 내용으로 결재 요청서를 써 주세요. 제목은 한 줄로, 사유는 누가·무엇을·왜·얼마를 담아 다섯 줄 안으로 정리하고, 결재자를 물어본 뒤 결재 앱의 submit으로 올립니다." }
    ]
  },
  "slashItems": [
    { "key": "summary", "name": { "en": "Approvals at a glance", "ko": "결재 현황" }, "keywords": ["approval", "결재", "dashboard"], "block": "summary" }
  ],
  "menuActions": [
    { "key": "draft", "name": { "en": "Ask for approval", "ko": "결재 올리기" }, "on": ["row", "page"], "action": "draft" }
  ]
}
