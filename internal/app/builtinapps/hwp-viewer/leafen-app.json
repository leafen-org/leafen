{
  "schema": 1,
  "id": "app.leafen.hwpviewer",
  "slug": "hwp-viewer",
  "version": "2.3.19",
  "name": { "en": "Hangul Documents", "ko": "한글 문서" },
  "description": {
    "en": "Opens Hangul (HWP and HWPX) documents on pages to read and edit them without Hancom Office, saving them in their own format.",
    "ko": "페이지에 붙은 한글(HWP·HWPX) 문서를 한컴오피스 없이 열어 읽고 편집하며, 원래 형식으로 저장합니다."
  },
  "developer": { "name": "Leafen" },
  "icon": "ui/icon.svg",
  "category": "work",
  "tags": ["document", "hwp"],
  "license": "AGPL-3.0-only",
  "webAssembly": true,
  "surfaces": {
    "fileOpeners": [
      {
        "key": "open",
        "name": { "en": "Hangul Documents", "ko": "한글 문서" },
        "types": [".hwp", ".hwpx", "application/x-hwp", "application/haansofthwp", "application/vnd.hancom.hwp", "application/hwp+zip", "application/vnd.hancom.hwpx"],
        "entry": "ui/index.html",
        "edit": true,
        "newFiles": [
          { "type": ".hwpx", "name": { "en": "Hangul document", "ko": "한글 문서" }, "template": "templates/blank.hwpx" }
        ]
      }
    ]
  },
  "personAccess": "openedFile",
  "network": {}
}
