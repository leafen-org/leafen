{
  "schema": 1,
  "id": "app.leafen.docviewer",
  "slug": "document-viewer",
  "version": "2.0.21",
  "name": { "en": "PDF Documents", "ko": "PDF 문서" },
  "description": {
    "en": "Opens PDF files on pages to read them, fill their forms and add text, drawings and highlights, saving them back as PDF.",
    "ko": "페이지에 붙은 PDF 파일을 열어 읽고, 양식을 채우고 글·그림·형광펜을 더해 PDF로 다시 저장합니다."
  },
  "developer": { "name": "Leafen" },
  "icon": "ui/icon.svg",
  "category": "work",
  "tags": ["document", "pdf"],
  "license": "AGPL-3.0-only",
  "webAssembly": true,
  "surfaces": {
    "fileOpeners": [
      {
        "key": "open",
        "name": { "en": "PDF Documents", "ko": "PDF 문서" },
        "types": [".pdf", "application/pdf"],
        "entry": "ui/index.html",
        "edit": true
      }
    ]
  },
  "personAccess": "openedFile",
  "network": {}
}
