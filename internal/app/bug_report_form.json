{
  "repository": "leafen-org/leafen",
  "newIssue": "https://github.com/leafen-org/leafen/issues/new",
  "form": "bug_report.yml",
  "issues": "https://github.com/leafen-org/leafen/issues",
  "search": "https://api.github.com/search/issues",
  "guide": "https://github.com/leafen-org/leafen/blob/main/docs/bug-reports.md",
  "security": "https://github.com/leafen-org/leafen/security/advisories/new",
  "fields": [
    { "id": "version", "label": "Leafen version", "required": true },
    { "id": "system", "label": "Operating system and install", "required": true },
    { "id": "data", "label": "Synthetic data", "required": true },
    { "id": "steps", "label": "Steps to reproduce", "required": true },
    { "id": "result", "label": "Expected and actual", "required": true },
    { "id": "fix", "label": "The fix you think of", "required": true },
    { "id": "details", "label": "Error reference, logs and screenshots", "required": false }
  ]
}
